# Database (Neon PostgreSQL em produção; ver docker-compose.yml para dev local)
DATABASE_URL=jdbc:postgresql://localhost:5432/lusotop
DATABASE_USERNAME=lusotop
DATABASE_PASSWORD=lusotop

# App
DEMO_MODE=true
JWT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# DingConnect
DINGCONNECT_API_KEY=
DINGCONNECT_BASE_URL=https://api.dingconnect.com
# A DingConnect exige IP fixo na whitelist para chamadas Live -- se o backend nao tiver IP
# de saida fixo (ex: Render sem add-on de IP dedicado), define isto para encaminhar os pedidos
# atraves de um proxy HTTP com IP fixo: http://user:pass@host:porta
DINGCONNECT_PROXY_URL=

# Google Sign-In (OAuth client ID only -- no client secret needed, ID tokens
# are verified server-side against Google's public keys)
GOOGLE_CLIENT_ID=
